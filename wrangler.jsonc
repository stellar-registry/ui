{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "registry-ui",
	"main": "./workers/app.ts",
	"compatibility_date": "2025-04-04",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true,
	},

	// Default vars for local development (wrangler dev reads .dev.vars)
	"vars": {
		"REGISTRY_API_URL": "https://stellar-registry-testnet.fly.dev",
		"REGISTRY_NETWORK": "testnet",
		"REGISTRY_RPC_URL": "https://soroban-testnet.stellar.org",
	},

	"env": {
		// ── Mainnet ──────────────────────────
		"stellar": {
			"name": "rgstry-stellar",
			"routes": [{ "pattern": "stellar.rgstry.xyz", "custom_domain": true }],
			"vars": {
				"REGISTRY_API_URL": "https://stellar-registry-mainnet.fly.dev",
				"REGISTRY_NETWORK": "mainnet",
				// TODO: no free public mainnet Soroban RPC endpoint exists — this
				// must be replaced with a real provider URL before the "Deploy"
				// button will work on mainnet. Deploys will fail against this
				// placeholder.
				"REGISTRY_RPC_URL": "https://REPLACE-ME-mainnet-rpc.example.com",
			},
		},

		// ── Testnet ──────────────────────────
		"testnet": {
			"name": "rgstry-testnet",
			"routes": [{ "pattern": "testnet.rgstry.xyz", "custom_domain": true }],
			"vars": {
				"REGISTRY_API_URL": "https://stellar-registry-testnet.fly.dev",
				"REGISTRY_NETWORK": "testnet",
				"REGISTRY_RPC_URL": "https://soroban-testnet.stellar.org",
			},
		},
	},
}
